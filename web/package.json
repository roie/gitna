{
  "name": "web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "tsc -p tsconfig.node.json && tsc -p tsconfig.react.json",
    "lint": "oxlint src tests",
    "format": "oxfmt --write src/diffshub/gitna src/diffshub/main.tsx src/diffshub/vite src/lib tests vite.config.ts playwright.config.ts postcss.config.mjs",
    "format:check": "oxfmt --check src/diffshub/gitna src/diffshub/main.tsx src/diffshub/vite src/lib tests vite.config.ts playwright.config.ts postcss.config.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@pierre/diffs": "1.3.6",
    "@pierre/icons": "0.7.1",
    "@pierre/theme": "^2.0.0",
    "@pierre/theming": "^1.0.1",
    "@pierre/trees": "1.0.0-beta.6",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-switch": "1.3.7",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tanstack/react-virtual": "3.14.10",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.37.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "postcss": "8.5.26",
    "postcss-import": "17.0.0",
    "tailwindcss": "4.3.3",
    "typescript": "~7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
