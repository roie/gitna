{
  "name": "web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "tsc -p tsconfig.node.json && tsc -p tsconfig.react.json",
    "lint": "oxlint src tests",
    "format": "oxfmt --write src/diffshub/gitna src/diffshub/main.tsx src/diffshub/vite src/lib tests vite.config.ts playwright.config.ts postcss.config.mjs",
    "format:check": "oxfmt --check src/diffshub/gitna src/diffshub/main.tsx src/diffshub/vite src/lib tests vite.config.ts playwright.config.ts postcss.config.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@pierre/diffs": "1.5.1",
    "@pierre/icons": "0.9.0",
    "@pierre/theme": "^2.0.0",
    "@pierre/theming": "^1.0.1",
    "@pierre/trees": "1.0.0-beta.6",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-switch": "1.3.7",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tanstack/react-virtual": "3.14.13",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "hast-util-to-jsx-runtime": "2.3.6",
    "lucide-react": "1.52.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0",
    "unified": "11.0.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "postcss": "8.5.28",
    "postcss-import": "17.0.0",
    "tailwindcss": "4.3.3",
    "typescript": "~7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
